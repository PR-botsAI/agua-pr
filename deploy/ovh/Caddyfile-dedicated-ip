api.h20pr.com {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  reverse_proxy api:8080 {
    health_uri /api/v1/health
    health_interval 30s
    health_timeout 5s
  }

  log {
    output stdout
    format console
  }
}
